{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Shared ASM compatibility and case manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "case_format_version",
        "asm_contract",
        "evidence_schema",
        "rule_language",
        "abstraction_behavior",
        "suites",
        "asms",
        "controller"
    ],
    "properties": {
        "case_format_version": {
            "type": "integer",
            "minimum": 1
        },
        "asm_contract": {
            "type": "integer",
            "minimum": 1
        },
        "evidence_schema": {
            "type": "integer",
            "minimum": 1
        },
        "rule_language": {
            "type": "integer",
            "minimum": 1
        },
        "abstraction_behavior": {
            "type": "string",
            "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "suites": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "directory",
                    "cases"
                ],
                "properties": {
                    "directory": {
                        "type": "string",
                        "pattern": "^[a-z0-9-]+$"
                    },
                    "cases": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^[a-z0-9-]+$"
                        }
                    }
                }
            }
        },
        "asms": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
            },
            "additionalProperties": {
                "type": "integer",
                "minimum": 1
            }
        },
        "controller": {
            "type": "integer",
            "minimum": 1
        }
    }
}
